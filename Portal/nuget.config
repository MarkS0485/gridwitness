<?xml version="1.0" encoding="utf-8"?>
<!--
  Restores the shared Estate.Data model from the private GitHub Packages feed.
  Token comes from the GH_PACKAGES_TOKEN env var (NuGet expands %GH_PACKAGES_TOKEN%),
  so no secret is committed. Set it locally for dev; pass it as a Docker build
  secret/arg for server-side restore. Source mapping keeps Estate.* on the GitHub
  feed and everything else on nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/MarkS0485/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Estate.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="MarkS0485" />
      <add key="ClearTextPassword" value="%GH_PACKAGES_TOKEN%" />
    </github>
  </packageSourceCredentials>
</configuration>
