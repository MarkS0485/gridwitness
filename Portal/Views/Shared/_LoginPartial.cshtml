@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var confirmed = user?.EmailConfirmed ?? false;
    <a asp-area="Identity" asp-page="/Account/Manage/Index" class="nav-link" title="@User.Identity?.Name">
        @if (!confirmed)
        {
            <i class="fa-solid fa-triangle-exclamation text-amber-300 mr-1" title="Email not confirmed"></i>
        }
        <i class="fa-solid fa-circle-user mr-1"></i>
        <span class="max-w-[10rem] truncate">@User.Identity?.Name</span>
    </a>
    <form class="inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post">
        <button type="submit" class="nav-link">SIGN OUT</button>
    </form>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Login" class="nav-link">LOGIN</a>
    <a asp-area="Identity" asp-page="/Account/Register" class="btn-primary !py-1.5 !px-3 !text-xs">REGISTER</a>
}
