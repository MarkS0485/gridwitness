@{
    var section = ViewData["Section"] as string ?? "";
    string Active(string s) => section == s ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is null ? "GridWitness" : ViewData["Title"] + " · GridWitness")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "GridWitness — a citizen-science network measuring the GB grid from the meters people already own.")" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%E2%9A%A1%3C/text%3E%3C/svg%3E" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="font-sans antialiased flex flex-col min-h-screen">

    <!-- ============ Top nav (slim, brand navy) ============ -->
    <header class="tsgb-nav-bar sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
            <div class="flex items-center justify-between h-14">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 text-white font-bold tracking-wide">
                    <i class="fa-solid fa-bolt text-tsgb-red"></i>
                    <span>GridWitness</span>
                </a>

                <nav class="hidden md:flex items-center gap-1">
                    <a asp-controller="Home" asp-action="Index" class="nav-link @Active("home")">HOME</a>
                    <a asp-controller="Home" asp-action="HowItWorks" class="nav-link @Active("how")">HOW IT WORKS</a>
                    <a asp-controller="Home" asp-action="Submitters" class="nav-link @Active("api")">API</a>
                    <a asp-controller="Home" asp-action="Schema" class="nav-link @Active("schema")">SCHEMA</a>
                    <a asp-controller="Home" asp-action="Privacy" class="nav-link @Active("privacy")">PRIVACY</a>
                    <a asp-controller="Dashboard" asp-action="Index" class="nav-link @Active("dashboard")">DASHBOARD</a>
                    <span class="w-px h-5 bg-white/15 mx-1"></span>
                    <partial name="_LoginPartial" />
                </nav>

                <button class="md:hidden text-white p-2" onclick="document.getElementById('mobnav').classList.toggle('hidden')" aria-label="Menu">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
        </div>
        <div id="mobnav" class="hidden md:hidden border-t border-white/10 px-4 py-2 space-y-1">
            <a asp-controller="Home" asp-action="Index" class="nav-link-mobile">Home</a>
            <a asp-controller="Home" asp-action="HowItWorks" class="nav-link-mobile">How it works</a>
            <a asp-controller="Home" asp-action="Submitters" class="nav-link-mobile">API</a>
            <a asp-controller="Home" asp-action="Schema" class="nav-link-mobile">Schema</a>
            <a asp-controller="Home" asp-action="Privacy" class="nav-link-mobile">Privacy</a>
            <a asp-controller="Dashboard" asp-action="Index" class="nav-link-mobile">Dashboard</a>
            <partial name="_LoginPartial" />
        </div>
    </header>

    <main class="flex-1">
        @RenderBody()
    </main>

    <!-- ============ Footer ============ -->
    <footer class="site-footer">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
            <div class="grid gap-8 md:grid-cols-4">
                <div class="md:col-span-2">
                    <div class="flex items-center gap-2 text-white font-bold text-lg">
                        <i class="fa-solid fa-bolt text-tsgb-red"></i> GridWitness
                    </div>
                    <p class="mt-3 text-sm max-w-md">
                        A citizen-science network measuring the GB grid from the meters people already own.
                        Privacy-first, UTC-true, open by design.
                    </p>
                    <p class="mt-3 text-xs text-white/50">
                        Ingest endpoint: <span class="font-mono">ingest.twinscrollgridbalancer.co.uk</span>
                    </p>
                </div>
                <div>
                    <div class="footer-head">Explore</div>
                    <a class="footer-link" asp-controller="Home" asp-action="HowItWorks">How it works</a>
                    <a class="footer-link" asp-controller="Home" asp-action="Submitters">API &amp; submitters</a>
                    <a class="footer-link" asp-controller="Home" asp-action="Schema">Data schema</a>
                </div>
                <div>
                    <div class="footer-head">Account</div>
                    <a class="footer-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                    <a class="footer-link" asp-controller="Home" asp-action="Privacy">Privacy &amp; GDPR</a>
                </div>
            </div>
            <div class="section-divider-slim my-6"></div>
            <div class="flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-white/50">
                <span>© @DateTime.UtcNow.Year Twin Scroll Grid Balancer. Contributor data is opt-in and revocable.</span>
                <span><span class="footer-status-dot"></span> Part of the TSGB estate</span>
            </div>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
