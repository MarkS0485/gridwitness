@model DashboardIndexVm
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Section"] = "dashboard";
}

<section class="uk-gradient-hero text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
                <h1 class="text-3xl font-bold">Your API keys</h1>
                <p class="text-white/80 mt-1">@Model.Email</p>
            </div>
            <a asp-action="Create" class="btn-primary"><i class="fa-solid fa-plus mr-2"></i>New API key</a>
        </div>
    </div>
</section>

<div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 space-y-4">

    @if (TempData["Message"] is string msg)
    {
        <div class="alert alert-success">@msg</div>
    }
    @if (TempData["Error"] is string terr)
    {
        <div class="alert alert-danger">@terr</div>
    }
    @if (Model.Error is not null)
    {
        <div class="alert alert-warning">@Model.Error</div>
    }

    @if (!Model.EmailConfirmed)
    {
        <div class="alert alert-warning">
            <i class="fa-solid fa-triangle-exclamation mt-0.5"></i>
            <div>
                <strong>Your email isn't confirmed yet.</strong>
                You can create keys and contribute data now, but you'll need a confirmed email to
                <em>change what a node shares</em> or <em>delete your data</em> — that's how we prove the account is yours.
                <a asp-area="Identity" asp-page="/Account/ResendEmailConfirmation" class="font-semibold underline">Resend confirmation email</a>.
            </div>
        </div>
    }

    @if (Model.Nodes.Count == 0)
    {
        <div class="glass-panel rounded-lg p-10 text-center">
            <div class="card-icon mx-auto mb-4"><i class="fa-solid fa-key"></i></div>
            <h2 class="text-xl font-bold text-tsgb-navy">No API keys yet</h2>
            <p class="text-gray-600 mt-2 max-w-md mx-auto">
                An API key registers one measurement node — a Home Assistant install, a meter, or your own uploader.
                Create one to start contributing to the GB grid map.
            </p>
            <a asp-action="Create" class="btn-primary mt-5"><i class="fa-solid fa-plus mr-2"></i>Create your first key</a>
        </div>
    }
    else
    {
        <div class="grid gap-4 md:grid-cols-2">
            @foreach (var n in Model.Nodes)
            {
                <div class="card p-5">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <div class="font-bold text-tsgb-navy truncate">@(string.IsNullOrEmpty(n.DeviceType) ? "Node" : n.DeviceType)</div>
                            <div class="text-xs text-gray-400 font-mono truncate">@n.NodeId</div>
                        </div>
                        <span class="status-pill @(n.LocTier == "anon" ? "offline" : "online")">@LocTierLabel(n.LocTier)</span>
                    </div>

                    <div class="mt-3 flex flex-wrap gap-1.5">
                        @foreach (var ch in n.Channels)
                        {
                            <span class="text-xs px-2 py-0.5 rounded-full bg-tsgb-navy/6 text-tsgb-navy">@GridWitnessCatalogue.ChannelLabel(ch)</span>
                        }
                    </div>

                    <div class="mt-4 flex items-center justify-between text-sm">
                        <span class="text-gray-500">
                            @if (!string.IsNullOrEmpty(n.LocRef))
                            {
                                <i class="fa-solid fa-location-dot mr-1"></i> <span class="font-mono">@n.LocRef</span>
                            }
                            else
                            {
                                <span class="text-gray-400">No location shared</span>
                            }
                        </span>
                        <a asp-action="Node" asp-route-id="@n.NodeId" class="text-tsgb-red font-semibold">Manage <i class="fa-solid fa-arrow-right text-xs"></i></a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@functions {
    static string LocTierLabel(string t) => t switch
    {
        "region" => "Region",
        "data_share" => "Data-share",
        _ => "Anonymous"
    };
}
