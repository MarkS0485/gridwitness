@model SurveyUploadVm
@{
    ViewData["Title"] = "Contribute a survey";
    ViewData["Section"] = "upload";
    var regions = GridWitnessCatalogue.Regions;
}

<section class="uk-gradient-hero text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
        <h1 class="text-3xl font-bold">Contribute a power-quality survey</h1>
        <p class="text-white/80 mt-1">
            Already logging a site? Drop your analyser exports here. We keep <strong>only frequency and
            voltage</strong> — nothing else in the file is stored — and use them to map the grid.
        </p>
    </div>
</section>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-8">

    <div class="alert alert-info mb-6 text-sm">
        <i class="fa-solid fa-shield-halved mr-2"></i>
        This is your data. We never sell it, and you can withdraw it or take a copy at any time from
        <a asp-action="Surveys" class="underline font-semibold">your surveys</a>. Current, power and
        everything else in the file are discarded before anything is saved.
    </div>

    <form asp-action="Index" method="post" enctype="multipart/form-data" id="survey-form"
          class="glass-panel rounded-lg p-6 space-y-6">
        <div asp-validation-summary="All" class="alert alert-danger"></div>

        <div>
            <label class="form-label" asp-for="Label">Survey name</label>
            <input asp-for="Label" class="form-input" placeholder="e.g. Acme Ltd — main switchroom, June" />
            <p class="form-help">A label so you can recognise this survey later.</p>
            <span asp-validation-for="Label" class="form-error"></span>
        </div>

        <div>
            <label class="form-label" asp-for="DeviceType">Analyser / device</label>
            <input asp-for="DeviceType" class="form-input" placeholder="e.g. Fluke 1770, Hioki PQ3100" />
            <p class="form-help">Optional — helps us understand the measurement quality.</p>
            <span asp-validation-for="DeviceType" class="form-error"></span>
        </div>

        <!-- ============ Drag-and-drop zone ============ -->
        <div>
            <div class="form-label">Survey files</div>
            <p class="form-help mb-3">CSV, TXT or PQDIF exports. Up to 100 files at once.</p>
            <label id="dropzone"
                   class="block rounded-lg border-2 border-dashed border-gray-300 hover:border-tsgb-navy/50 bg-gray-50/60 cursor-pointer transition-colors">
                <div class="px-6 py-10 text-center">
                    <i class="fa-solid fa-cloud-arrow-up text-3xl text-tsgb-navy/60"></i>
                    <p class="mt-3 font-semibold text-tsgb-navy">Drag files here, or click to choose</p>
                    <p class="text-sm text-gray-500 mt-1">.csv · .txt · .tsv · .pqd · .pqdif — max 100 files</p>
                </div>
                <input type="file" name="files" id="file-input" multiple
                       accept=".csv,.txt,.tsv,.pqd,.pqdif" class="hidden" />
            </label>
            <ul id="file-list" class="mt-3 space-y-1 text-sm"></ul>
            <p id="file-count" class="form-help mt-2"></p>
        </div>

        <!-- ============ Location (required for surveys) ============ -->
        <div>
            <div class="form-label">Where was this measured?</div>
            <p class="form-help mb-3">
                Required — a voltage reading is only useful pinned to a place. A postcode never leaves
                the server; only a coarse derived grid area is stored with your data.
            </p>
            <div class="space-y-2" id="loctiers">
                @foreach (var (val, title, blurb) in new[] {
                    ("region", "Region", "Pick a GB region from a list. No address."),
                    ("data_share", "Postcode area", "Enter a postcode; we derive a coarse grid area and keep the postcode private.") })
                {
                    <label class="flex items-start gap-3 p-3 rounded-lg border border-gray-200 hover:border-tsgb-navy/40 cursor-pointer">
                        <input type="radio" name="LocTier" value="@val" checked="@(Model.LocTier == val)" class="mt-1 loctier" style="accent-color:#C8102E;width:1rem;height:1rem;" />
                        <span>
                            <span class="font-semibold text-tsgb-navy">@title</span>
                            <span class="block text-sm text-gray-600 mt-0.5">@blurb</span>
                        </span>
                    </label>
                }
            </div>
        </div>

        <div id="region-field">
            <label class="form-label" asp-for="Region">Region</label>
            <select asp-for="Region" class="form-select">
                <option value="">— choose a region —</option>
                @foreach (var r in regions)
                {
                    <option value="@r.Value">@r.Label</option>
                }
            </select>
            <span asp-validation-for="Region" class="form-error"></span>
        </div>

        <div id="postcode-field" class="hidden">
            <label class="form-label" asp-for="Postcode">Postcode</label>
            <input asp-for="Postcode" class="form-input" placeholder="e.g. BS1 5AH" />
            <p class="form-help">Kept private on the server. Only a coarse derived area is stored with your data.</p>
            <span asp-validation-for="Postcode" class="form-error"></span>
        </div>

        <div>
            <label class="form-label" asp-for="Notes">Notes (optional)</label>
            <textarea asp-for="Notes" class="form-textarea" rows="2" placeholder="Anything useful about the survey"></textarea>
            <span asp-validation-for="Notes" class="form-error"></span>
        </div>

        <label class="flex items-start gap-3 p-3 rounded-lg border border-gray-200">
            <input asp-for="Consent" type="checkbox" class="mt-1" style="accent-color:#C8102E;width:1rem;height:1rem;" />
            <span class="text-sm text-gray-700">
                I'm happy to contribute the frequency and voltage from these files to GridWitness. I
                understand it's my data, I can withdraw it at any time, and it will never be sold.
            </span>
        </label>
        <span asp-validation-for="Consent" class="form-error"></span>

        <div class="flex items-center justify-between pt-2">
            <a asp-action="Surveys" class="btn-outline">My surveys</a>
            <button type="submit" id="submit-btn" class="btn-primary">
                <i class="fa-solid fa-cloud-arrow-up mr-2"></i>Contribute survey
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function syncLocFields() {
            var v = document.querySelector('input[name="LocTier"]:checked')?.value;
            document.getElementById('region-field').classList.toggle('hidden', v !== 'region');
            document.getElementById('postcode-field').classList.toggle('hidden', v !== 'data_share');
        }
        document.querySelectorAll('.loctier').forEach(function (el) { el.addEventListener('change', syncLocFields); });
        syncLocFields();
    </script>
    <script src="~/js/upload.js" asp-append-version="true"></script>
}
