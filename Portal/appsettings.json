{
  "ConnectionStrings": {
    // Prod: the SHARED estate SQL Server connection, injected via env
    // ConnectionStrings__DefaultConnection. This Sqlite default is standalone-dev only.
    "DefaultConnection": "Data Source=App_Data/portal.db"
  },
  // Identity store provider. "Sqlite" (standalone dev) or "SqlServer" (prod, the SHARED estate DB).
  // ManageSchema=false in prod so the portal never migrates the shared Identity tables (TSGBWebsite
  // owns them). PortalDbContext declares no tables of its own. Set via env on the server.
  "Database": {
    "Provider": "Sqlite",
    "ManageSchema": true
  },
  // Cross-subdomain SSO. These MUST match the estate in production (set via env):
  //   ApplicationName — shared DataProtection app name (key-ring compatibility)
  //   KeysDirectory   — the shared, bind-mounted key-ring folder (mounted read-only)
  //   CookieName      — the estate Identity cookie name
  //   CookieDomain    — the shared parent domain (.twinscrollgridbalancer.co.uk)
  // Blank here so localhost dev is ordinary host-only behaviour.
  "Auth": {
    "ApplicationName": "TSGBWebsite",
    "KeysDirectory": "",
    "CookieName": ".AspNetCore.Identity.Application",
    "CookieDomain": ""
  },
  "Ingest": {
    "BaseUrl": "http://localhost:8000",
    "InternalKey": ""
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "FromEmail": "no-reply@twinscrollgridbalancer.co.uk",
    "FromName": "GridWitness",
    "UseStartTls": true
  },
  "Bundling": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
