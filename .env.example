# Copy to `.env` (gitignored) next to compose.yml and fill in.

# Shared secret the portal uses to reach the ingest server's internal admin API. It never crosses the
# public internet (private container network only). Generate a long random value, e.g.:
#   openssl rand -base64 36
GW_INTERNAL_KEY=change-me-to-a-long-random-string

# SMTP (Proton, same account as TSGBWebsite). Host/user/from default in compose.yml — only the token
# is needed here. Leave blank to log confirmation links to stdout instead of sending.
SMTP_PASSWORD=
# Optional overrides (defaults: smtp.protonmail.ch / 587 / noreply@twinscrollgridbalancer.co.uk):
# SMTP_HOST=smtp.protonmail.ch
# SMTP_USER=noreply@twinscrollgridbalancer.co.uk
# SMTP_FROM=noreply@twinscrollgridbalancer.co.uk
# SMTP_FROMNAME=GridWitness
